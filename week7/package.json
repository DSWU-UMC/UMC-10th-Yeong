    "dev1": "nodemon --ext ts,prisma --exec \"npx prisma generate && tsx src/index.ts\"",
    "dev2": "npx tsx watch src/index.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
